# Copiar a .env.dev y completar solo en el equipo local. No publicar ese archivo.
# Si se usa Docker, POSTGRES_PASSWORD y DB_PASSWORD deben coincidir.
POSTGRES_DB=bodeko
POSTGRES_USER=bodeko
POSTGRES_PASSWORD=

DB_URL=jdbc:postgresql://localhost:5432/bodeko
DB_USERNAME=bodeko
DB_PASSWORD=

# Generar una clave aleatoria de al menos 32 bytes. No reutilizar la clave de otro entorno.
JWT_SECRET=
JWT_EXPIRATION_MS=3600000

FRONTEND_URL=http://localhost:3000

# Clave ficticia del simulador local. Reemplazar solo en .env.dev al usar Culqi real.
CULQI_SECRET_KEY=
CULQI_API_URL=http://127.0.0.1:8199/v2

MAIL_PROVIDER=logging
MAIL_FROM=
RESEND_API_URL=https://api.resend.com
RESEND_API_KEY=
