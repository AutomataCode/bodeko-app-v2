    {
      "name": "1. Autenticación",
      "auth": {
        "type": "noauth"
      },
      "description": "Propietarios usan /api/auth/login. Los clientes inician sesión dentro de cada tienda.",
      "item": [
        {
          "name": "Registrar propietario",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register-owner",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register-owner"
              ]
            },
            "description": "Crea una cuenta de propietario (tabla users) y devuelve su token.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"propietario@correo.com\",\n  \"password\": \"Password123\",\n  \"fullName\": \"María García\",\n  \"phoneNumber\": \"+51987654321\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code < 300) { const j = pm.response.json(); const v = j.token; if (v) pm.collectionVariables.set('ownerToken', v); }"
                ]
              }
            }
          ]
        },
